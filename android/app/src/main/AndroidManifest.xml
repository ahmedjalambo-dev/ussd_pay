<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app's only dangerous permission, requested when the user taps
         "Contacts" and never at startup. Refusing it costs nothing: the number
         can always be typed. There is deliberately no CALL_PHONE permission:
         the app hands the code to the system dialer and the user presses call,
         so the last word on sending money is always theirs. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Android 13+ (API 33) requires a runtime prompt to post notifications.
         Used only for the local "did the payment go through?" prompt after
         the user opens the dialer or copies the code. If the user denies it
         the confirm screen keeps its AppBar "Done" button as the fallback. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- "Confirm by SMS" keeps a foreground service up for the 5-minute SMS
         wait. Without it, Android's cached-app freezer (and MIUI's battery
         saver) freeze the app once the user is in the dialer, and the SMS
         notification is only delivered when they come back. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- Not every target device has telephony, and the app is still useful
         (build and copy a code) without it. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>

    <application
        android:label="USSD Pay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Optional "Confirm by SMS": reads the wallet's own "money sent" SMS
             from its notification, so a payment can be marked Done without
             the user tapping anything. Notification access (granted by the
             user in system settings, off until they turn it on) rather than
             READ_SMS/RECEIVE_SMS: Google Play only allows SMS permissions for
             default SMS apps. The service itself drops every notification
             except the wallet's SMS sender while a payment is waiting; see
             PaymentSmsListenerService. -->
        <service
            android:name=".PaymentSmsListenerService"
            android:exported="true"
            android:label="USSD Pay"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- flutter_local_notifications' foreground service, started by
             NotificationService.showWaitingForSms for the SMS wait and stopped
             as soon as the wait ends (match, manual answer, or 5 minutes).
             specialUse because no standard type fits: shortService is cut
             off after ~3 minutes, inside the 5-minute window, and dataSync
             would be a false declaration. -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits up to 5 minutes for the user's mobile-wallet SMS to confirm a payment they just made"/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without this, canLaunchUrl("tel:...")
             returns false even when a dialer is installed. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
